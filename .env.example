# Copy to .env on your own machine; never commit a populated file.
# Run: node --env-file=.env server.mjs
# Hosted Sites: use runtime environment variables; mark VISION_API_KEY secret.
VISION_PROVIDER=compatible
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash
VISION_API_KEY=
# For a downloaded local Ollama vision model, use VISION_PROVIDER=ollama,
# set VISION_MODEL to its actual local name, and omit BASE_URL/API_KEY.
